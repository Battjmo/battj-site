---
const services = [
  {
    title: 'Team & Leadership',
    description:
      'Hiring plans, org design, and engineering culture — so you grow the right people in the right roles at the right time.',
    icon: '◈',
  },
  {
    title: 'Infrastructure & Reliability',
    description:
      'CI/CD, observability, and cloud architecture that match your stage — dependable without enterprise bloat.',
    icon: '◎',
  },
  {
    title: 'Codebase & Process',
    description:
      'Standards, review practices, and technical debt strategy that keep velocity high as the team grows.',
    icon: '◇',
  },
  {
    title: 'Executive Partnership',
    description:
      'Bridge engineering and leadership — translate tradeoffs, set realistic roadmaps, and align the org on priorities.',
    icon: '◆',
  },
];
---

<section id="services" class="bg-frozen py-24">
  <div class="mx-auto max-w-6xl px-6">
    <div class="max-w-2xl">
      <p class="text-sm font-semibold uppercase tracking-widest text-cerulean">Services</p>
      <h2 class="font-display mt-3 text-3xl font-semibold text-indigo md:text-4xl">
        Built for startups between traction and scale
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-cerulean">
        Mid-stage companies don't need a Big Tech playbook. You need pragmatic leadership that
        respects where you've been and where you're going.
      </p>
    </div>

    <div class="mt-14 grid gap-6 sm:grid-cols-2">
      {
        services.map((service) => (
          <article class="group rounded-2xl border border-frosted bg-white p-8 shadow-sm transition-shadow hover:shadow-md">
            <span class="text-2xl text-scarlet" aria-hidden="true">
              {service.icon}
            </span>
            <h3 class="mt-4 text-xl font-semibold text-indigo">{service.title}</h3>
            <p class="mt-3 leading-relaxed text-cerulean">{service.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
