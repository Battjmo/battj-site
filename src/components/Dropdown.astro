---
export interface Props {
  label: string;
  items: { href: string; label: string }[];
  align?: 'left' | 'right';
}

const { label, items, align = 'left' } = Astro.props;
const uid = crypto.randomUUID().slice(0, 8);
const popoverId = `dropdown-${uid}`;
const anchorName = `--anchor-${uid}`;
const positionArea = align === 'right' ? 'bottom span-left' : 'bottom span-right';
---

<div class="inline-block">
  <button
    type="button"
    popovertarget={popoverId}
    class="dropdown-trigger flex items-center gap-1 text-sm font-medium text-frosted transition-colors hover:text-frozen"
    style={`anchor-name: ${anchorName};`}
  >
    {label}
    <svg
      class="dropdown-chevron h-4 w-4"
      viewBox="0 0 20 20"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      aria-hidden="true"
    >
      <path d="m5 7.5 5 5 5-5" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </button>

  <menu
    id={popoverId}
    popover="auto"
    class="dropdown-menu min-w-40 rounded-xl border border-indigo/10 bg-frozen p-1.5 shadow-lg shadow-indigo/10"
    style={`position-anchor: ${anchorName}; position-area: ${positionArea};`}
  >
    {
      items.map((item) => (
        <a
          href={item.href}
          class="block rounded-lg px-3 py-2 text-sm font-medium text-indigo transition-colors hover:bg-cerulean/10"
        >
          {item.label}
        </a>
      ))
    }
  </menu>
</div>

<style>
  .dropdown-menu {
    margin: 0.5rem 0 0 0;
    position-try-fallbacks: flip-block;
  }

  .dropdown-chevron {
    transition: transform 150ms ease;
  }

  .dropdown-trigger.is-open .dropdown-chevron {
    transform: rotate(180deg);
  }
</style>

<script>
  document.addEventListener(
    'toggle',
    (e) => {
      const menu = e.target;
      if (!(menu instanceof HTMLElement) || !menu.matches('.dropdown-menu')) return;

      const trigger = document.querySelector(`[popovertarget="${menu.id}"]`);
      const isOpen = (e as ToggleEvent).newState === 'open';
      trigger?.classList.toggle('is-open', isOpen);
      if (isOpen) menu.querySelector('a')?.focus();
    },
    true
  );

  document.addEventListener('keydown', (e) => {
    const menu = (e.target as HTMLElement).closest?.('.dropdown-menu');
    if (!menu) return;

    const links = [...menu.querySelectorAll<HTMLAnchorElement>('a')];
    const current = links.indexOf(document.activeElement as HTMLAnchorElement);

    if (e.key === 'ArrowDown') {
      e.preventDefault();
      links[(current + 1) % links.length]?.focus();
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      links[(current - 1 + links.length) % links.length]?.focus();
    } else if (e.key === 'Home') {
      e.preventDefault();
      links[0]?.focus();
    } else if (e.key === 'End') {
      e.preventDefault();
      links.at(-1)?.focus();
    }
  });
</script>
